# --- Local tooling / editor state ---
.claude/settings.local.json
.DS_Store

# --- Account-specific deployment config (never commit — contains real values) ---
# Produced by `csp values` from an order file
.connect-skill-values.json
.connect-skill-order.json

# --- Per-deployment stack outputs (real account IDs, instance IDs, pool IDs) ---
# Written by `cdk deploy --outputs-file cdk-outputs.json` in any rendered project
cdk-outputs.json

# --- Node / CDK build artifacts (in the template and any rendered project) ---
node_modules/
cdk.out/
*.tsbuildinfo

# Rendered CDK projects (generated by `csp render` / the skill)
csp-*/
widget-embed.txt
.connect-skill-order.*

# Rendered projects written by tests/test-render-and-synth.sh
tests/.rendered/
